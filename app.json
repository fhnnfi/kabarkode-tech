{
  "expo": {
    "name": "KabarKode",
    "slug": "kabarkode-tech",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "kabarkode",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "backgroundColor": "#111111",
      "resizeMode": "contain"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/kabarkodeblack.png"
    },
    "plugins": [
      "expo-router",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      }
    }
  }
}
